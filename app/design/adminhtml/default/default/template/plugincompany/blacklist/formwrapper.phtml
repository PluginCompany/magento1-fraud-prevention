<script type="text/javascript">
    function showSuspicionOptionsWindow() {
        var windowHtml = suspicionOptionsWindowHtml();
        if(windowHtml == ''){
            //no options to choose from
            submitSuspicion();
        }else{
            var suspicionOptionsWindow = new Window({className:'magento',
                title:'Fraud Suspicion Options',
                width:600,
                height:330,
                minimizable:false,
                maximizable: false
            });
            suspicionOptionsWindow.showCenter(true);
            suspicionOptionsWindow.getContent().update(windowHtml);
        }

    }
    function suspicionOptionsWindowHtml(){
           return '<?php echo str_replace(array("\n","\r"),'',$this->getFormHtml());?>';
    }

    function submitSuspicion() {
        window.location = "<?php echo $this->getFormUrl(); ?>";
    }
</script>
