<config>
    <modules>
        <Plugincompany_Blacklist>
            <version>1.4.0</version>
        </Plugincompany_Blacklist>
    </modules>
    <global>
        <resources>
            <plugincompany_blacklist_setup>
                <setup>
                    <module>Plugincompany_Blacklist</module>
                    <class>Plugincompany_Blacklist_Model_Resource_Setup</class>
                </setup>
            </plugincompany_blacklist_setup>
        </resources>
        <blocks>
            <plugincompany_blacklist>
                <class>Plugincompany_Blacklist_Block</class>
            </plugincompany_blacklist>
        </blocks>
        <helpers>
            <plugincompany_blacklist>
                <class>Plugincompany_Blacklist_Helper</class>
            </plugincompany_blacklist>
        </helpers>
        <models>
            <plugincompany_blacklist>
                <class>Plugincompany_Blacklist_Model</class>
                <resourceModel>plugincompany_blacklist_resource</resourceModel>
            </plugincompany_blacklist>
            <plugincompany_blacklist_resource>
                <class>Plugincompany_Blacklist_Model_Resource</class>
                <entities>
                    <item>
                        <table>plugincompany_blacklist_item</table>
                    </item>
                    <rule>
                        <table>plugincompany_blacklist_rule</table>
                    </rule>
                    <item_store>
                        <table>plugincompany_blacklist_item_store</table>
                    </item_store>
                    <rule_store>
                        <table>plugincompany_blacklist_rule_store</table>
                    </rule_store>
                </entities>
            </plugincompany_blacklist_resource>
        </models>
        <events>
            <sales_order_save_after>
                <observers>
                    <plugincompany_blacklist>
                        <type>model</type>
                        <class>plugincompany_blacklist/observer</class>
                        <method>salesOrderSaveAfter</method>
                    </plugincompany_blacklist>
                </observers>
            </sales_order_save_after>
        </events>
    </global>
    <adminhtml>
        <layout>
            <updates>
                <plugincompany_blacklist>
                    <file>plugincompany_blacklist.xml</file>
                </plugincompany_blacklist>
            </updates>
        </layout>
        <translate>
            <modules>
                <Plugincompany_Blacklist>
                    <files>
                        <default>Plugincompany_Blacklist.csv</default>
                    </files>
                </Plugincompany_Blacklist>
            </modules>
        </translate>
        <events>
            <core_block_abstract_to_html_before>
                <observers>
                    <add_order_grid_column>
                        <type>model</type>
                        <class>plugincompany_blacklist/observer</class>
                        <method>addOrderGridColumn</method>
                    </add_order_grid_column>
                    <add_blacklist_buttons>
                        <type>model</type>
                        <class>plugincompany_blacklist/observer</class>
                        <method>addButtons</method>
                    </add_blacklist_buttons>
                    <plugincompany_blacklist>
                        <type>model</type>
                        <class>plugincompany_blacklist/observer</class>
                        <method>applyRenderer</method>
                    </plugincompany_blacklist>
                    <add_customer_grid_column>
                        <type>model</type>
                        <class>plugincompany_blacklist/observer_addCustomerGridColumn</class>
                        <method>execute</method>
                    </add_customer_grid_column>
                    <add_order_grid_massactions>
                        <type>model</type>
                        <class>plugincompany_blacklist/observer_addOrderGridMassactions</class>
                        <method>execute</method>
                    </add_order_grid_massactions>
                </observers>
            </core_block_abstract_to_html_before>
            <sales_order_grid_collection_load_before>
                <observers>
                    <plugincompany_blacklist>
                        <type>model</type>
                        <class>plugincompany_blacklist/observer</class>
                        <method>salesOrderGridCollectionLoadBefore</method>
                    </plugincompany_blacklist>
                </observers>
            </sales_order_grid_collection_load_before>
            <eav_collection_abstract_load_before>
                <observers>
                    <plugincompany_blacklist>
                        <type>model</type>
                        <class>plugincompany_blacklist/observer_addCustomerGridColumn</class>
                        <method>updateCollection</method>
                    </plugincompany_blacklist>
                </observers>
            </eav_collection_abstract_load_before>
        </events>
    </adminhtml>
    <admin>
        <routers>
            <adminhtml>
                <args>
                    <modules>
                        <Plugincompany_Blacklist before="Mage_Adminhtml">Plugincompany_Blacklist_Adminhtml</Plugincompany_Blacklist>
                    </modules>
                </args>
            </adminhtml>
        </routers>
    </admin>
    <frontend>
        <events>
            <core_block_abstract_to_html_after>
                <observers>
                    <plugincompany_blacklist>
                        <type>model</type>
                        <class>plugincompany_blacklist/observer</class>
                        <method>hidePaymentMethodBlock</method>
                    </plugincompany_blacklist>
                </observers>
            </core_block_abstract_to_html_after>
            <controller_action_predispatch>
                <observers>
                    <plugincompany_blacklist>
                        <type>model</type>
                        <class>plugincompany_blacklist/observer</class>
                        <method>controllerActionPredispatch</method>
                    </plugincompany_blacklist>
                </observers>
            </controller_action_predispatch>
            <sales_model_service_quote_submit_failure>
                <observers>
                    <plugincompany_blacklist>
                        <type>model</type>
                        <class>plugincompany_blacklist/observer</class>
                        <method>salesModelServiceQuoteSubmitFailure</method>
                    </plugincompany_blacklist>
                </observers>
            </sales_model_service_quote_submit_failure>
            <sales_quote_address_save_after>
                <observers>
                    <plugincompany_blacklist>
                        <type>model</type>
                        <class>plugincompany_blacklist/observer</class>
                        <method>checkCustomerAddressQuote</method>
                    </plugincompany_blacklist>
                </observers>
            </sales_quote_address_save_after>
            <customer_address_save_after>
                <observers>
                    <plugincompany_blacklist>
                        <type>model</type>
                        <class>plugincompany_blacklist/observer</class>
                        <method>checkCustomerAddressAccount</method>
                    </plugincompany_blacklist>
                </observers>
            </customer_address_save_after>
        </events>
    </frontend>
    <default>
        <plugincompany_blacklist>
            <plugincompany_blacklist_payment>
